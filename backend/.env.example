# Application Configuration
APP_NAME=LaundryTrack
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (VPS PostgreSQL)
DB_HOST=45.66.153.146
DB_PORT=5432
DB_USER=laundrytrack_user
DB_PASSWORD=your_secure_password_here
DB_NAME=laundrytrack_db
DB_ECHO=False

# SQLAlchemy Connection Strings
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
SYNC_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# JWT & Security
JWT_SECRET_KEY=change_this_to_a_random_secret_key_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080"]
